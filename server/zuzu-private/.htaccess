# Belt and braces: if this folder is ever uploaded inside public_html by
# mistake, refuse to serve anything from it - config.php holds the key.
# Both syntaxes plus a rewrite, so Apache 2.2, 2.4 and LiteSpeed all refuse.
<IfModule mod_authz_core.c>
Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
Order allow,deny
Deny from all
</IfModule>
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^ - [F]
</IfModule>
